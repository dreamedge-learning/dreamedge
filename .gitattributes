# Line-ending and diff policy for the repository.
#
# Everything is stored with LF in the repository and checked out with LF on
# every platform, so a Windows clone and a Linux CI runner see identical bytes
# and a stray CRLF can never slip into a commit again. The toolchain (Next.js,
# Flutter, the Linux CI) is LF throughout, so there is nothing that needs CRLF
# on checkout.

# Default: let Git detect text, normalise it to LF in the repo, and check it
# out as LF everywhere.
* text=auto eol=lf

# ---------------------------------------------------------------------------
# Source and config — explicit so the intent is readable, even though the
# default above already covers them.
# ---------------------------------------------------------------------------
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.html       text eol=lf
*.json       text eol=lf
*.jsonc      text eol=lf
*.dart       text eol=lf
*.sql        text eol=lf
*.kt         text eol=lf
*.kts        text eol=lf
*.gradle     text eol=lf
*.pro        text eol=lf
*.xml        text eol=lf
*.svg        text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.toml       text eol=lf
*.properties text eol=lf
*.md         text eol=lf
*.metadata   text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Windows-only scripts keep CRLF, should any ever be added.
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# ---------------------------------------------------------------------------
# Lock files: text, but noisy and never hand-merged.
# ---------------------------------------------------------------------------
package-lock.json  text eol=lf -diff linguist-generated=true
pubspec.lock       text eol=lf
*.lock             text eol=lf

# ---------------------------------------------------------------------------
# Binary assets: never normalise, never diff or merge.
# ---------------------------------------------------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.jks    binary
*.keystore binary
