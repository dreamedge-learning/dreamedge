# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# Cloudflare R2 (future)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Video (Bunny Stream)
# All four are server-only on purpose. None may be prefixed NEXT_PUBLIC_:
# that is what keeps them out of the browser bundle, and the API key in
# particular would let anyone holding it upload to and delete from the library.
#
# Library ID, API key and CDN hostname come from Stream > the library > API.
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
#
# The pull zone's URL token authentication key, from CDN > the Stream pull
# zone > Security. This is NOT the library's "embed view token" key: that one
# signs iframe URLs, and we sign the CDN URLs the app and hls.js play directly.
# BUNNY_STREAM_TOKEN_KEY=

# Email (Resend — future)
# RESEND_API_KEY=

# Sentry (crash reporting — future)
# Two DSNs for the same Sentry project: the NEXT_PUBLIC_ one is the only form
# the browser bundle can read, the plain one is for the server and edge
# runtimes. Leave both unset and Sentry never initialises — the app runs
# exactly as before. Paste the same project DSN into both to turn it on.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
#
# Optional, build-time only. Set all three (SENTRY_AUTH_TOKEN as a secret) to
# upload source maps so stack traces de-minify in Sentry. Without the token no
# upload is attempted and the build is unaffected.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
